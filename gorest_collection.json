        {
          "name": "Duplicate Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test(\"Hệ thống phát hiện email đã tồn tại\", function () {",
                  "    const res = pm.response.json();",
                  "    const emailError = res.find(err => err.field === \"email\");",
                  "    pm.expect(emailError.message).to.eql(\"has already been taken\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate Tester\",\n  \"gender\": \"female\",\n  \"email\": \"{{createdEmail}}\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
