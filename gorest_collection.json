  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "let userList = JSON.parse(pm.collectionVariables.get(\"userDataList\"));",
                  "let currentIndex = parseInt(pm.collectionVariables.get(\"userLoopIndex\"));",
                  "",
                  "// Lưu email của user đầu tiên (index = 0) để chắc chắn email này tồn tại và không bị xóa",
                  "if (currentIndex === 0) {",
                  "    pm.environment.set(\"createdEmail\", res.email);",
                  "}",
                  "",
                  "// Lưu ID của user cuối cùng (index = 2) để thực hiện chuỗi GET, PATCH, DELETE ở sau",
                  "if (currentIndex === userList.length - 1) {",
                  "    pm.environment.set(\"userId\", res.id);",
                  "}",
                  "",
                  "// Điều khiển vòng lặp",
                  "if (currentIndex < userList.length - 1) {",
                  "    pm.collectionVariables.set(\"userLoopIndex\", currentIndex + 1);",
                  "    postman.setNextRequest(\"Create User\");",
                  "} else {",
                  "    pm.collectionVariables.unset(\"userDataList\");",
                  "    pm.collectionVariables.unset(\"userLoopIndex\");",
                  "    postman.setNextRequest(\"User Details\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Khởi tạo mảng dữ liệu 3 users nếu chưa có",
                  "if (!pm.collectionVariables.get(\"userDataList\")) {",
                  "    const timestamp = Date.now();",
                  "    const data = [",
                  "        {",
                  "            name: \"Nguyen Van A\",",
                  "            gender: \"male\",",
                  "            email: `nguyenvana_${timestamp}_1@example.com`,",
                  "            status: \"active\"",
                  "        },",
                  "        {",
                  "            name: \"Tran Thi B\",",
                  "            gender: \"female\",",
                  "            email: `tranthib_${timestamp}_2@example.com`,",
                  "            status: \"active\"",
                  "        },",
                  "        {",
                  "            name: \"Le Van C\",",
                  "            gender: \"male\",",
                  "            email: `levanc_${timestamp}_3@example.com`,",
                  "            status: \"active\"",
                  "        }",
                  "    ];",
                  "    pm.collectionVariables.set(\"userDataList\", JSON.stringify(data));",
                  "    pm.collectionVariables.set(\"userLoopIndex\", 0);",
                  "}",
                  "",
                  "// Lấy thông tin user hiện tại theo index",
                  "let userList = JSON.parse(pm.collectionVariables.get(\"userDataList\"));",
                  "let currentIndex = parseInt(pm.collectionVariables.get(\"userLoopIndex\"));",
                  "let currentUser = userList[currentIndex];",
                  "",
                  "// Đưa vào biến dùng trong Body",
                  "pm.variables.set(\"current_name\", currentUser.name);",
                  "pm.variables.set(\"current_gender\", currentUser.gender);",
                  "pm.variables.set(\"current_email\", currentUser.email);",
                  "pm.variables.set(\"current_status\", currentUser.status);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{current_name}}\",\n  \"gender\": \"{{current_gender}}\",\n  \"email\": \"{{current_email}}\",\n  \"status\": \"{{current_status}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "User Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Kiểm tra đúng ID của user vừa tạo\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.id).to.eql(pm.environment.get(\"userId\"));",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Status đã được đổi thành inactive\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.status).to.eql(\"inactive\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
